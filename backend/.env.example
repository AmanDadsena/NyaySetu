# Environment
# ──────────────────────────────────
# Copy this file to `.env` and fill in real values.
# Everything here is optional — the app runs with none of it set.

# FastAPI
APP_ENV=development
DEBUG=true

# CORS – comma-separated origins. *.vercel.app is already allowed by pattern.
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────
# Unset  → local SQLite file (fine for development, wiped on every restart
#          of an ephemeral container, so do not use it in production).
# Set    → Postgres. Paste the URL your provider gives you as-is; the
#          `postgres://` prefix and any `?sslmode=` are rewritten for the
#          async driver automatically.
#
# Free tiers that persist: neon.tech, supabase.com
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/nyaysetu?sslmode=require

# Drop and recreate all tables on boot. Destroys data — local schema work only.
# RESET_DB=1

# ── Answer generation (all optional) ──────────────────────────────────
# The assistant answers from the retrieval corpus with none of these set.
# Each one only improves how the answer is *phrased*, never its legal content.

# A model running locally via Ollama. No key, no quota.
#   ollama pull gemma3:4b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# How long a chat turn waits for the local model before answering extractively.
# CHAT_BUDGET_SECONDS=18

# Hosted fallback, tried only if the local model is unavailable.
# GEMINI_API_KEY=your_api_key_here
# GEMINI_MODEL=gemini-2.0-flash

# ── Retrieval ─────────────────────────────────────────────────────────
# Minimum lexical score for a question to count as in-corpus. Below it the
# assistant declines rather than guessing. Recalibrate via app.rag.eval after
# a large corpus change.
# NYAYSETU_MIN_BM25=4.8

# Skip loading sentence-transformers even if installed.
# NYAYSETU_DISABLE_DENSE=1

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving this unset in production means every deploy can forge tokens.
# JWT_SECRET_KEY=change_me
