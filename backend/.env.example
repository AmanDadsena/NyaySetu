# Environment
# ──────────────────────────────────
# Copy this file to `.env` and fill in real values.
# Everything here is optional — the app runs with none of it set.

# FastAPI
APP_ENV=development
DEBUG=true

# CORS – comma-separated origins. *.vercel.app is already allowed by pattern.
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────
# Unset  → local SQLite file (fine for development, wiped on every restart
#          of an ephemeral container, so do not use it in production).
# Set    → Postgres. Paste the URL your provider gives you as-is; the
#          `postgres://` prefix and any `?sslmode=` are rewritten for the
#          async driver automatically.
#
# Free tiers that persist: neon.tech, supabase.com
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/nyaysetu?sslmode=require

# Drop and recreate all tables on boot. Destroys data — local schema work only.
# RESET_DB=1

# ── Answer generation (all optional) ──────────────────────────────────
# The assistant answers from the retrieval corpus with none of these set.
# Each one only improves how the answer is *phrased*, never its legal content.

# A model running locally via Ollama. No key, no quota.
#   ollama pull gemma3:4b
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma3:4b
# How long a chat turn waits for the local model before answering extractively.
# CHAT_BUDGET_SECONDS=18

# Skip the local model entirely. Set in both production configs, and worth
# setting locally too unless you are working on that path.
#
# The reason is answer quality, not speed. Asked in Hindi who the current Chief
# Justice is, gemma3:4b replies with a list of judges out of its training data —
# the corpus names nobody, on purpose, because nothing here can keep a name
# current. Naming a sitting judge wrongly in a legal tool is worse than the few
# seconds the local model saves. `python -m scripts.check_fabrication` asks all
# eight languages and fails if any reply invents a name: 1 of 8 fail with the
# local model, 0 of 8 without it.
#
# Distinct from OLLAMA_STRIKES, which only reacts once a request has been slow.
# NYAYSETU_DISABLE_OLLAMA=1

# Hosted fallback, tried only if the local model is unavailable or disabled.
# GEMINI_API_KEY=your_api_key_here
# gemini-2.0-flash is decommissioned and returns 404 NOT_FOUND.
# GEMINI_MODEL=gemini-2.5-flash

# ── Retrieval ─────────────────────────────────────────────────────────
# Minimum lexical score for a question to count as in-corpus. Below it the
# assistant declines rather than guessing. Recalibrate via app.rag.eval after
# a large corpus change — the corpus growing shifts the idf distribution, which
# is what moved this from 4.8 to its current value.
# NYAYSETU_MIN_BM25=5.5

# Minimum cosine similarity for the embeddings alone to admit a question, when
# there is no lexical signal at all. Swept against off-topic questions in all
# eight languages; see the note in app/rag/retriever.py before changing it.
# NYAYSETU_MIN_DENSE=0.35

# How much more BM25's ordering is trusted than the embeddings' when the two are
# fused. Swept against the full eval: lowering it helps English and hurts the
# other seven languages.
# NYAYSETU_LEXICAL_WEIGHT=0.80

# Skip loading sentence-transformers even if installed.
# NYAYSETU_DISABLE_DENSE=1

# ── Feedback log (off unless this is set) ─────────────────────────────
# Records what retrieval did with each question so `python -m scripts.gaps` can
# rank where the corpus is thin. No user id, account or IP is stored. Question
# text is only kept if NYAYSETU_FEEDBACK_TEXT=1 as well, because these are
# people's legal problems. The file is gitignored.
# NYAYSETU_FEEDBACK_LOG=data/feedback.jsonl
# NYAYSETU_FEEDBACK_TEXT=1

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving this unset in production means every deploy can forge tokens.
# JWT_SECRET_KEY=change_me
